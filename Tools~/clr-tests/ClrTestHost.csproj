<Project Sdk="Microsoft.NET.Sdk">
  <!-- Hosts the bundled Infrastructure/Clojure.dll on .NET Framework 4.8 to run
       Source/clojure/test_clojure without Unity. See docs/plans (U3). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <BaseIntermediateOutputPath>.....buildobjr-tests</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Clojure"><HintPath>..\..\Infrastructure\Clojure.dll</HintPath></Reference>
    <None Include="..\..\Infrastructure\*.dll" CopyToOutputDirectory="PreserveNewest" LinkBase="." />
  </ItemGroup>
</Project>
